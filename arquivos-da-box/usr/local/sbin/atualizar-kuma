#!/bin/bash
# Atualiza o Uptime Kuma para a última release estável da mesma versão principal (2.x), com volta automática.
# Roda pelo timer atualizar-kuma.timer (domingo de madrugada). Log: journalctl -u atualizar-kuma
set -uo pipefail
DIR=/opt/uptime-kuma
DADOS=/var/lib/uptime-kuma/data
# A versão vem do package.json (o clone raso não guarda a tag).
atual=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$DIR/package.json" | head -1)
atual=${atual:-desconhecida}
nova=$(curl -fsS --max-time 30 https://api.github.com/repos/louislam/uptime-kuma/releases/latest | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
[ -n "$nova" ] || { echo "não consegui ver a última versão; nada feito"; exit 0; }
echo "instalada: $atual | última: $nova"
[ "$nova" = "$atual" ] && { echo "já está na última"; exit 0; }
# Pula mudança de versão principal (ex.: 2.x -> 3.x): pode exigir migração; fica para fazer à mão.
[ "${nova%%.*}" = "${atual%%.*}" ] || { echo "versão principal mudou ($atual -> $nova); atualizar à mão"; exit 0; }

saudavel() {
  for _ in $(seq 1 40); do
    curl -fsS --max-time 5 http://127.0.0.1:3001/api/entry-page >/dev/null 2>&1 && return 0
    sleep 6
  done
  return 1
}

systemctl stop uptime-kuma
cp -a "$DADOS/kuma.db" "$DADOS/kuma.db.antes-$nova" 2>/dev/null || true
if sudo -u kuma git -C "$DIR" fetch --quiet --depth 1 origin tag "$nova" \
  && sudo -u kuma git -C "$DIR" checkout --quiet "$nova" \
  && (cd "$DIR" && sudo -u kuma -H env NODE_OPTIONS=--max-old-space-size=384 npm ci --omit=dev --no-audit --no-fund --loglevel=error) \
  && (cd "$DIR" && sudo -u kuma -H npm run download-dist --silent) \
  && systemctl start uptime-kuma && saudavel; then
  echo "atualizado para $nova"
  # Guarda só o backup mais recente do banco.
  ls -1t "$DADOS"/kuma.db.antes-* 2>/dev/null | tail -n +2 | xargs -r rm -f
  exit 0
fi

echo "falhou com $nova; voltando para $atual"
systemctl stop uptime-kuma
cp -a "$DADOS/kuma.db.antes-$nova" "$DADOS/kuma.db"
sudo -u kuma git -C "$DIR" checkout --quiet "$atual"
(cd "$DIR" && sudo -u kuma -H env NODE_OPTIONS=--max-old-space-size=384 npm ci --omit=dev --no-audit --no-fund --loglevel=error)
(cd "$DIR" && sudo -u kuma -H npm run download-dist --silent)
systemctl start uptime-kuma
saudavel && echo "voltou para $atual" || echo "ATENÇÃO: o Kuma não subiu nem na versão antiga"
exit 1
